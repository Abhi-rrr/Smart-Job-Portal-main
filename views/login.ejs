<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <link rel="stylesheet" href="/css/login.css">
    
</head>
<% if (typeof error !== 'undefined') { %>
  <script>
    alert("<%= error %>");
  </script>
<% } %>

<body>
    <div class="signup-container">
        <div class="signup-header">
            <h1>Sign In</h1>
            <p>Create your account today</p>
        </div>

        <form id="signupForm" action="/user/login" method="post">
            <!-- Role selection section -->
            <div class="role-selection">
                <label>Select Your Role</label>
                <div class="role-options">
                    <div class="role-option">
                        <input type="radio" id="recruiter" name="role" value="recruiter" required>
                        <label for="recruiter" class="role-option-label">
                            <span class="role-icon">👔</span>
                            Recruiter
                        </label>
                    </div>
                    <div class="role-option">
                        <input type="radio" id="candidate" name="role" value="candidate" required>
                        <label for="candidate" class="role-option-label">
                            <span class="role-icon">👤</span>
                            Candidate
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" required>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required>
            </div>

            <button type="submit" class="signup-btn">Create Account</button>
        </form>

        <div class="login-link">
            <p>Already have an account? <a href="#">Sign in</a></p>
        </div>
    </div>

    
</body>
</html>