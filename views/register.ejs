<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <link rel="stylesheet" href="/css/register.css">


</head>
<body>
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <div class="signup-container">
        <div class="signup-header">
            <h1>Sign Up</h1>
            <p>Create your account today</p>
        </div>

        <form id="signupForm" action="/user/register" method="post">
            <!-- New role selection section -->
            <div class="role-selection">
                <label>Select Your Role</label>
                <div class="role-options">
                    <div class="role-option">
                        <input type="radio" id="recruiter" name="role" value="recruiter" required>
                        <label for="recruiter" class="role-option-label">
                            <span class="role-icon">👔</span>
                            Recruiter
                        </label>
                    </div>
                    <div class="role-option">
                        <input type="radio" id="candidate" name="role" value="candidate" required>
                        <label for="candidate" class="role-option-label">
                            <span class="role-icon">👤</span>
                            Candidate
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" required>
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required>
            </div>

            <button type="submit" class="signup-btn">Create Account</button>
        </form>

        <div class="login-link">
            <p>Already have an account? <a href="#">Sign in</a></p>
        </div>
    </div>

    <script>
        // Add form submission handling to show selected role
       // document.getElementById('signupForm').addEventListener('submit', function(e) {
           
            
            const formData = new FormData(this);
            const role = formData.get('role');
            const username = formData.get('username');
            
            if (role && username) {
                alert(`Account created successfully as ${role.charAt(0).toUpperCase() + role.slice(1)}!`);
                // Here you would normally submit the form to your server
                this.submit();
            }
       // });
   

  
       
    // Clear all localStorage when new user registers
    localStorage.clear();
</script>


</body>
</html>