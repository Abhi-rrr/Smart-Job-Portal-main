<!DOCTYPE html>
<html lang="en">
<head>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.14.305/pdf.min.js"></script>
<script src="https://unpkg.com/mammoth/mammoth.browser.min.js"></script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - JobHub</title>
    <link rel="stylesheet" href="/css/dashboard.css">
   
</head>
<body>
    <div class="dashboard-container">
        <!-- Header -->
        <div class="dashboard-header">
            <div class="welcome-section">
                <h1 class="welcome-title">Welcome, <span id="username"><%= user.firstName || 'User' %></span>!</h1>
                <p class="welcome-subtitle">Ready to find your next opportunity?</p>
                <p class="last-login">Last login: Today at 10:30 AM</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="dashboard-content">
            <!-- Profile Section -->
            <div class="profile-card">
                <h2 class="card-title">
                    <span class="card-icon">👤</span>
                    Personal Information
                </h2>
                
                <div class="success-message" id="profileSuccess">
                    Profile updated successfully!
                </div>

                <form id="profileForm" action="/user/update-profile" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label class="form-label" for="firstName">First Name</label>
                        <input type="text" class="form-input" id="firstName" name="firstName" placeholder="Enter your first name"  value="<%= user.firstName || '' %>">
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="lastName">Last Name</label>
                        <input type="text" class="form-input" id="lastName" name="lastName" placeholder="Enter your last name" value="<%= user.lastName || '' %>">
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="phoneNo">Phone Number</label>
                        <input type="tel" class="form-input" id="phoneNo" name="phoneNo" placeholder="Enter your phone number" value="<%= user.phoneNo || '' %>">
                    </div>

                    <button type="submit" class="btn-primary">Update Profile</button>
                </form>
            </div>

            <!-- Resume Section -->
            <div class="resume-card">
                <h2 class="card-title">
                    <span class="card-icon">📄</span>
                    Resume Management
                </h2>

                <div class="success-message" id="resumeSuccess">
                    Resume uploaded successfully!
                </div>
                <div id="predictedCategory" style="margin-top: 10px; font-weight: bold; color: green;"></div>

               <a href="/user/applyjobs" class="btn-primary apply-jobs-button" onclick="handleApplyJobs()" >Apply Jobs</a>
               <a href="/user/applied_job" class="btn-primary apply-jobs-button">Applied Jobs</a>

               <!-- Extracted Skills Section -->
<!-- Show predicted category -->
<div id="predictedCategory" style="margin-top: 10px; font-weight: bold; color: green;"></div>

<!-- Skill output container -->
<div class="skills-card">
    <h2 class="card-title">
        <span class="card-icon">🧠</span>
        Extracted Skills
    </h2>
    <div class="skills-list" id="extractedSkills">
        <p style="color: gray;">No skills extracted yet.</p>
    </div>
</div>




                <!-- Current Resume Display -->
                <div class="current-resume" id="currentResume" style="display: none;">
                    <div class="resume-info">
                        <div class="file-icon">📄</div>
                        <div class="file-details">
                            <h4 id="fileName">Resume.pdf</h4>
                            <p id="fileSize">2.5 MB • Uploaded 2 days ago</p>
                        </div>
                        <div class="file-actions">
                            <button class="btn-secondary" onclick="downloadResume()">Download</button>
                            <button class="btn-danger" onclick="deleteResume()">Delete</button>
                        </div>
                    </div>
                </div>

                <!-- Upload Area -->
                <div class="resume-upload-area" id="uploadArea" >
                    <div class="upload-icon">📁</div>
                    <div class="upload-text">Drag and drop your resume here</div>
                    <div class="upload-subtext">or click to browse files</div>
                    <div class="upload-subtext">Supports PDF, DOC, DOCX (Max 10MB)</div>
                </div>

<input type="file" name="resumeFile" class="file-input" id="resumeFile" accept=".pdf,.doc,.docx"  onchange="handleFileUpload(this.files[0])" >
                
                <button type="button" class="btn-primary" onclick="document.getElementById('resumeFile').click()">
                    Choose File
                </button>
            </div>
        </div>

        <!-- Stats Section -->
        
    </div>

    <script>
        // Profile Form Handling
        document.getElementById('profileForm').addEventListener('submit', function(e) {
    e.preventDefault();

    const firstName = document.getElementById('firstName').value;
    const lastName = document.getElementById('lastName').value;
    const phoneNo = document.getElementById('phoneNo').value;

    // Update UI
    if (firstName && lastName) {
        document.getElementById('username').textContent = `${firstName} ${lastName}`;
        document.getElementById('userAvatar').textContent = `${firstName[0]}${lastName[0]}`;
    }

    const successMsg = document.getElementById('profileSuccess');
    successMsg.style.display = 'block';
    setTimeout(() => {
        successMsg.style.display = 'none';
    }, 3000);

    // Save to localStorage (optional)
    localStorage.setItem('firstName', firstName);
    localStorage.setItem('lastName', lastName);
    localStorage.setItem('phoneNo', phoneNo);

    // ✅ Actually send to backend
    submitProfile(); // 👈 Add this
});


        // Resume Upload Handling
        const uploadArea = document.getElementById('uploadArea');
        const resumeFile = document.getElementById('resumeFile');
        const currentResume = document.getElementById('currentResume');

        // Click to upload
        uploadArea.addEventListener('click', () => {
            resumeFile.click();
        });

        // Drag and drop functionality
        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.classList.add('dragover');
        });

        uploadArea.addEventListener('dragleave', () => {
            uploadArea.classList.remove('dragover');
        });

        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.classList.remove('dragover');
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                handleFileUpload(files[0]);
            }
        });

        // File input change
        resumeFile.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
                handleFileUpload(e.target.files[0]);
            }
        });
function handleFileUpload(file) {
    const formData = new FormData();
    formData.append('resume', file);

    fetch('http://127.0.0.1:5000/api/extract', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        console.log('Prediction response:', data);

        const skillsContainer = document.getElementById('extractedSkills');
        skillsContainer.innerHTML = '';

        if (data.skills && data.skills.length > 0) {
            data.skills.forEach(skill => {
                const input = document.createElement('input');
                input.type = 'text';
                input.value = skill;
                input.readOnly = true;
                skillsContainer.appendChild(input);
            });

            // ✅ Save to database only if skills were extracted
            const userId = localStorage.getItem('userId');
            if (userId) {
                fetch('/user/saveskills', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        userId: userId,
                        skills: data.skills
                    })
                })
                .then(res => res.json())
                .then(result => {
                    console.log('Skills saved to DB:', result);
                })
                .catch(err => {
                    console.error('Error saving skills:', err);
                });
            }

        } else {
            skillsContainer.innerHTML = '<p style="color: gray;">No skills extracted from this resume.</p>';
        }

        // Show file info
        document.getElementById('fileName').textContent = file.name;
        document.getElementById('fileSize').textContent = `${(file.size / 1024 / 1024).toFixed(2)} MB • Just uploaded`;
        document.getElementById('currentResume').style.display = 'block';
    })
    .catch(error => {
        console.error('Error uploading file:', error);
        alert('Failed to upload resume. Please try again.');
    });
}



        function extractTextFromFile(file) {
    return new Promise((resolve, reject) => {
        if (file.type === 'application/pdf') {
            const reader = new FileReader();
            reader.onload = async function() {
                const typedArray = new Uint8Array(this.result);
                const pdf = await pdfjsLib.getDocument(typedArray).promise;
                let text = '';
                for (let i = 1; i <= pdf.numPages; i++) {
                    const page = await pdf.getPage(i);
                    const content = await page.getTextContent();
                    text += content.items.map(item => item.str).join(' ') + ' ';
                }
                resolve(text);
            };
            reader.onerror = reject;
            reader.readAsArrayBuffer(file);
        } 
        else if (file.type === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document') {
            const reader = new FileReader();
            reader.onload = function(event) {
                mammoth.extractRawText({arrayBuffer: event.target.result})
                    .then(result => resolve(result.value))
                    .catch(reject);
            };
            reader.onerror = reject;
            reader.readAsArrayBuffer(file);
        } 
        else if (file.type === 'application/msword') {
            reject('DOC (old Word) parsing not supported in-browser. Please upload PDF or DOCX.');
        } 
        else {
            reject('Unsupported file type.');
        }
    });
}

        function downloadResume() {
            // Here you would typically download the file from your backend
            alert('Resume download started!');
        }

        function deleteResume() {
            if (confirm('Are you sure you want to delete your resume?')) {
                currentResume.style.display = 'none';
                uploadArea.style.display = 'block';
                resumeFile.value = '';
                // Here you would typically delete the file from your backend
                console.log('Resume deleted');
            }
        }

        // Auto-update initials when username changes
        function updateUserAvatar() {
            const username = document.getElementById('username').textContent;
            const names = username.split(' ');
            if (names.length >= 2) {
                const initials = names[0][0] + names[1][0];
                document.getElementById('userAvatar').textContent = initials;
            }
        }

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            updateUserAvatar();
            
    localStorage.setItem('userId', "<%= user._id %>");
            // Load saved profile data if available
            

    // ✅ Clear localStorage if redirected after registration
    const params = new URLSearchParams(window.location.search);
    if (params.get('registered') === 'true') {
        localStorage.removeItem('firstName');
        localStorage.removeItem('lastName');
        localStorage.removeItem('phoneNo');
        console.log('Cleared localStorage due to registration');
    }

    // ✅ Load profile data from localStorage
    
           
        });

        // Save profile data to localStorage when form is submitted
       
       function submitProfile() {
    const firstName = document.getElementById('firstName').value;
    const lastName = document.getElementById('lastName').value;
    const phoneNo = document.getElementById('phoneNo').value;

    fetch('/user/update-profile', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ firstName, lastName, phoneNo })
    })
    .then(res => res.json())
    .then(data => {
        alert('Profile updated!');
        console.log(data);
    })
    .catch(err => {
        console.error(err);
        alert('Error updating profile.');
    });
}
// Replace handleApplyJobs function in dashboard
async function handleApplyJobs() {
    const userId = localStorage.getItem('userId');
    if (!userId) {
        alert('User not logged in');
        return;
    }

    // Simply redirect to apply jobs page
    // The matching will be calculated there automatically
    window.location.href = '/user/applyjobs';
}
    </script>
</body>
</html>